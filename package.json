{
  "name": "mini-rostock-3d",
  "private": true,
  "version": "0.1.0",
  "description": "Ein Echtzeit-3D-Karten-Erlebnis für den Straßenbahnverkehr in Rostock – inspiriert von mini-tokyo-3d, gebaut mit CesiumJS und Google Photorealistic 3D Tiles.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "data:update": "node scripts/fetch-osm-network.mjs",
    "data:gtfs": "node scripts/fetch-gtfs-schedule.mjs",
    "postinstall": "node scripts/copy-cesium-assets.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "cesium": "^1.144.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "fflate": "^0.8.3",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
