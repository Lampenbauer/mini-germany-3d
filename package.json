{
  "name": "mini-rostock-3d",
  "private": true,
  "version": "0.1.0",
  "description": "Ein Echtzeit-3D-Karten-Erlebnis für den Straßenbahnverkehr in Rostock – inspiriert von mini-tokyo-3d, gebaut mit CesiumJS und Google Photorealistic 3D Tiles.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:update": "node scripts/fetch-osm-network.mjs",
    "data:gtfs": "node scripts/fetch-gtfs-schedule.mjs",
    "data:simplify": "node scripts/simplify-network.mjs",
    "data:heights": "node scripts/fetch-route-heights.mjs",
    "data:lamps": "node scripts/fetch-street-lamps.mjs",
    "models:build": "node scripts/build-vehicle-models.mjs",
    "postinstall": "node scripts/copy-cesium-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "cesium": "^1.144.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^2.2.0",
    "jsdom": "^30.0.1",
    "pngjs": "^7.0.0",
    "proj4": "^2.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
