# Cesium-Ion-Token (https://ion.cesium.com/tokens)
# Überschreibt den in src/config.ts hinterlegten Standard-Token.
VITE_CESIUM_ION_TOKEN=

# Optional: URL des gefilterten GTFS-Realtime-Endpunkts (JSON).
# Standard (wenn nicht gesetzt): /api/realtime – im Dev-Server von der
# Vite-Middleware bedient, in Produktion von api/realtime.php.
# Leerer String deaktiviert GTFS-Realtime komplett.
# VITE_GTFS_RT_URL=/api/realtime
