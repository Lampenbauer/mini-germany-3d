# Cesium-Ion-Token (https://ion.cesium.com/tokens)
# Überschreibt den in src/config.ts hinterlegten Standard-Token.
VITE_CESIUM_ION_TOKEN=

# Optional: URL des GTFS-Realtime-Feeds (TripUpdates, Protobuf).
# Standard (wenn nicht gesetzt): /gtfs-rt/realtime-free.pb – der freie
# gtfs.de-Feed über den Vite-Proxy (siehe vite.config.ts).
# Leerer String deaktiviert GTFS-Realtime komplett.
# VITE_GTFS_RT_URL=/gtfs-rt/realtime-free.pb
