# Cesium-Ion-Token (https://ion.cesium.com/tokens)
# Überschreibt den in src/config.ts hinterlegten Standard-Token.
VITE_CESIUM_ION_TOKEN=

# Optional: URL eines GTFS-Realtime-Feeds (VehiclePositions/TripUpdates, Protobuf).
# Wenn gesetzt, kann die App perspektivisch echte Fahrzeugpositionen anzeigen
# (siehe README, Abschnitt "GTFS-Realtime").
VITE_GTFS_RT_URL=
