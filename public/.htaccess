# Mini Germany 3D – Apache configuration (all-inkl shared hosting)

# /api/realtime → PHP endpoint (filtered GTFS-Realtime feed)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/realtime$ api/realtime.php [L]
</IfModule>

# Caching: Vite-hashed assets may be cached "forever",
# index.html never (users would see stale bundles), Cesium statics moderately.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/cesium/#">
    Header set Cache-Control "public, max-age=86400"
  </If>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# Compression for text resources
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
