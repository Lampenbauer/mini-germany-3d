# Mini Rostock 3D – Apache-Konfiguration (all-inkl Shared Hosting)

# /api/realtime → PHP-Endpunkt (gefilterter GTFS-Realtime-Feed)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/realtime$ api/realtime.php [L]
</IfModule>

# Caching: von Vite gehashte Assets dürfen "für immer" gecacht werden,
# index.html nie (sonst sehen Nutzer alte Bundles), Cesium-Statik moderat.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/cesium/#">
    Header set Cache-Control "public, max-age=86400"
  </If>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# Kompression für Text-Ressourcen
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
