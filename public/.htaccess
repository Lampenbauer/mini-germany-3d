# Mini Germany 3D – Apache configuration (all-inkl shared hosting)
#
# Every city is a directory of its own (/berlin/, /en/berlin/ – see
# src/lib/site-path.ts) with the index.html the build wrote into it, so
# no rewrite is needed for them: Apache serves the directory's index and
# turns /berlin into /berlin/ itself (DirectorySlash). A path that is no
# city is a real 404, which is what a crawler should get.

# /api/realtime → PHP endpoint (filtered GTFS-Realtime feed)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/realtime$ api/realtime.php [L]
  RewriteRule ^api/webcams$ api/webcams.php [L]
  RewriteRule ^api/aircraft$ api/aircraft.php [L]
</IfModule>

# Caching: Vite-hashed assets may be cached "forever",
# index.html never (users would see stale bundles), Cesium statics moderately.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/cesium/#">
    Header set Cache-Control "public, max-age=86400"
  </If>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# The procedural models (public/models/*.glb) are served as what they
# are – Apache's own table does not know the extension, and a type it
# does not know is application/octet-stream, which no rule below would
# compress.
AddType model/gltf-binary .glb

# Compression for text resources – the AIS archive's hour files
# (application/x-ndjson, see api/ais.php) shrink to a fifth – and for the
# models: a mesh of repeated fittings deflates to a fifth as well (the
# detailed fleet is 7.9 MB raw, 1.7 MB on the wire), which
# is what makes a harbour city's first visit bearable on a phone.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/x-ndjson image/svg+xml model/gltf-binary
</IfModule>

# The keys the deploy writes next to the scripts in api/ (see ci.yml) are
# for the scripts alone: webcams-key.txt from the WINDY_KEY repository
# secret for api/webcams.php, cron-key.txt from CRON_KEY for the keeper
# crons of api/ais.php and api/aircraft.php.
<FilesMatch "^(webcams|cron)-key\.txt$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
